{
  "name": "libero",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "server",
    "shared",
    "client/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace server",
    "dev:admin": "npm run dev --workspace @libero/admin",
    "dev:reader": "npm run dev --workspace @libero/reader",
    "build": "npm run build --workspace server",
    "build:admin": "npm run build --workspace @libero/admin",
    "build:reader": "npm run build --workspace @libero/reader",
    "start": "npm run start --workspace server",
    "seed": "npm run seed --workspace server",
    "seed:reset-demo": "npm run seed:reset-demo --workspace server",
    "lint": "npm run lint --workspace server",
    "typecheck": "npm run typecheck --workspace server",
    "typecheck:admin": "npm run typecheck --workspace @libero/admin",
    "typecheck:reader": "npm run typecheck --workspace @libero/reader",
    "test": "npm run test --workspace server",
    "test:admin": "npm run test:run --workspace @libero/admin",
    "test:reader": "npm run test:run --workspace @libero/reader"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "tailwindcss": "^4.2.4"
  }
}
